      "Bash(flutter analyze *)",
      "Bash(flutter build *)",
      "Bash(gh *)",
      "Bash(xcode-select -p)",
      "Bash(xcodebuild -version)",
      "Bash(swift --version)",
      "Bash(plutil -convert xml1 -o - /Users/mrkzk/Desktop/StockMemo/ios/Runner/Info.plist)",
